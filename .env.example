SHADCNBLOCKS_API_KEY=your_api_key_here

# AWS SES SMTP
SES_SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=your_ses_smtp_user
SES_SMTP_PASS=your_ses_smtp_password

# Email Settings (update per project)
