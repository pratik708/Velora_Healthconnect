---
import { MenubarSubTrigger as ReactMenubarSubTrigger } from "@/components/ui/menubar";

interface Props {
  class?: string;
  inset?: boolean;
  disabled?: boolean;
  textValue?: string;
}

const { class: className, ...rest } = Astro.props;
---

<ReactMenubarSubTrigger client:visible className={className} {...rest}>
  <slot />
</ReactMenubarSubTrigger>
