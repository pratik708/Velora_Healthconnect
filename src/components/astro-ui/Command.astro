---
import { Command as ReactCommand } from "@/components/ui/command";

interface Props {
  class?: string;
  value?: string;
  onValueChange?: (value: string) => void;
  filter?: (value: string, search: string) => number;
  shouldFilter?: boolean;
  loop?: boolean;
  label?: string;
}

const { class: className, ...rest } = Astro.props;
---

<ReactCommand client:visible className={className} {...rest}>
  <slot />
</ReactCommand>
