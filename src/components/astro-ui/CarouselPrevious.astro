---
import { CarouselPrevious as ReactCarouselPrevious } from "@/components/ui/carousel";

interface Props {
  class?: string;
  variant?:
    | "default"
    | "destructive"
    | "outline"
    | "secondary"
    | "ghost"
    | "link";
  size?: "default" | "sm" | "lg" | "icon";
}

const { class: className, variant = "outline", size = "icon" } = Astro.props;
---

<ReactCarouselPrevious
  client:visible
  className={className}
  variant={variant}
  size={size}
/>
