---
import { ResizablePanel as ReactResizablePanel } from "@/components/ui/resizable";

interface Props {
  class?: string;
  defaultSize?: number;
  minSize?: number;
  maxSize?: number;
  collapsible?: boolean;
  collapsedSize?: number;
  id?: string;
}

const { class: className, ...rest } = Astro.props;
const panelProps: any = { className, ...rest };
---

<ReactResizablePanel client:visible {...panelProps}>
  <slot />
</ReactResizablePanel>
