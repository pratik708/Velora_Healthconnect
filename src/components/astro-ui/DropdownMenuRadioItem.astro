---
import { DropdownMenuRadioItem as ReactDropdownMenuRadioItem } from "@/components/ui/dropdown-menu";

interface Props {
  class?: string;
  value: string;
  disabled?: boolean;
  onSelect?: (event: Event) => void;
  textValue?: string;
}

const { class: className, ...rest } = Astro.props;
---

<ReactDropdownMenuRadioItem client:visible className={className} {...rest}>
  <slot />
</ReactDropdownMenuRadioItem>
