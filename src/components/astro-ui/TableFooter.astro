---
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
}

const { class: className, ...props } = Astro.props;
---

<tfoot
  data-slot="table-footer"
  class={cn(
    "bg-muted/50 border-t font-medium [&>tr]:last:border-b-0",
    className,
  )}
  {...props}
>
  <slot />
</tfoot>
