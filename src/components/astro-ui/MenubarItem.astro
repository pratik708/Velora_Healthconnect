---
import { MenubarItem as ReactMenubarItem } from "@/components/ui/menubar";

interface Props {
  class?: string;
  inset?: boolean;
  variant?: "default" | "destructive";
  disabled?: boolean;
  onSelect?: (event: Event) => void;
  textValue?: string;
}

const { class: className, ...rest } = Astro.props;
---

<ReactMenubarItem client:visible className={className} {...rest}>
  <slot />
</ReactMenubarItem>
