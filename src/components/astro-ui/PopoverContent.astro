---
import { PopoverContent as ReactPopoverContent } from "@/components/ui/popover";

interface Props {
  align?: "start" | "center" | "end";
  side?: "top" | "right" | "bottom" | "left";
  sideOffset?: number;
  class?: string;
}

const { class: className, ...props } = Astro.props;
---

<ReactPopoverContent client:visible className={className} {...props}>
  <slot />
</ReactPopoverContent>
