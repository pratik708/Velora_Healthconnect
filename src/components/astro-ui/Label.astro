---
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
  for?: string;
}

const { class: className, for: htmlFor } = Astro.props;
---

<label
  for={htmlFor}
  class={cn(
    "text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70",
    className,
  )}
>
  <slot />
</label>
