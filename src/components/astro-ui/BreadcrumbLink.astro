---
import { cn } from "@/lib/utils";

interface Props {
  href?: string;
  class?: string;
}

const { href, class: className, ...props } = Astro.props;
---

<a
  href={href}
  data-slot="breadcrumb-link"
  class={cn("hover:text-foreground transition-colors", className)}
  {...props}
>
  <slot />
</a>
