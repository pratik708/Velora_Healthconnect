---
import { Button as ReactButton, buttonVariants } from "@/components/ui/button";
import type { VariantProps } from "class-variance-authority";

type ButtonVariants = VariantProps<typeof buttonVariants>;

interface Props extends ButtonVariants {
  class?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  href?: string;
  interactive?: boolean;
}

const {
  class: className,
  variant = "default",
  size = "default",
  interactive = false,
  href,
  ...props
} = Astro.props;

const classes = buttonVariants({ variant, size, className });
---

{
  href ? (
    <a
      data-slot="button"
      data-variant={variant}
      data-size={size}
      href={href}
      class={classes}
      {...props}
    >
      <slot />
    </a>
  ) : interactive ? (
    <ReactButton
      client:visible
      className={className}
      variant={variant}
      size={size}
      {...props}
    >
      <slot />
    </ReactButton>
  ) : (
    <button
      data-slot="button"
      data-variant={variant}
      data-size={size}
      class={classes}
      {...props}
    >
      <slot />
    </button>
  )
}
