---
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
}

const { class: className, ...props } = Astro.props;
---

<div data-slot="table-container" class="relative w-full overflow-x-auto">
  <table
    data-slot="table"
    class={cn("w-full caption-bottom text-sm", className)}
    {...props}
  >
    <slot />
  </table>
</div>
