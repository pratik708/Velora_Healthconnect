---
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
}

const { class: className, ...props } = Astro.props;
---

<ol
  data-slot="breadcrumb-list"
  class={cn(
    "text-muted-foreground flex flex-wrap items-center gap-1.5 text-sm break-words sm:gap-2.5",
    className,
  )}
  {...props}
>
  <slot />
</ol>
