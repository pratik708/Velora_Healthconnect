---
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn("", className)}>
  <div id="form-container">
    <h2 class="font-heading text-2xl font-bold text-primary sm:text-3xl">
      Send us a message
    </h2>
    <p class="mt-2 text-muted-foreground leading-relaxed">
      Tell us about your health goals and we will get back to you within 1 business day.
    </p>

    <div
      id="form-error"
      hidden
      class="mt-6 rounded-lg border border-destructive/50 bg-destructive/10 px-4 py-3 text-sm text-destructive"
    >
    </div>

    <form id="contact-form" class="mt-8 space-y-5">
      <div class="grid sm:grid-cols-2 gap-5">
        <div class="space-y-2">
          <label for="name" class="text-sm leading-none font-medium">Name <span class="text-destructive">*</span></label>
          <input
            id="name"
            name="name"
            placeholder="Your full name"
            required
            autocomplete="name"
            class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:ring-1 focus-visible:ring-ring focus-visible:outline-none"
          />
        </div>
        <div class="space-y-2">
          <label for="phone" class="text-sm leading-none font-medium">Phone</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            placeholder="Your phone number"
            autocomplete="tel"
            class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:ring-1 focus-visible:ring-ring focus-visible:outline-none"
          />
        </div>
      </div>

      <div class="space-y-2">
        <label for="email" class="text-sm leading-none font-medium">Email <span class="text-destructive">*</span></label>
        <input
          id="email"
          name="email"
          type="email"
          placeholder="you@example.com"
          required
          autocomplete="email"
          class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:ring-1 focus-visible:ring-ring focus-visible:outline-none"
        />
      </div>

      <div class="space-y-2">
        <label for="service" class="text-sm leading-none font-medium">I am interested in</label>
        <select
          id="service"
          name="service"
          class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs transition-colors focus-visible:ring-1 focus-visible:ring-ring focus-visible:outline-none"
        >
          <option value="">Select a service (optional)</option>
          <option value="weight-management">Weight Management</option>
          <option value="peptide-therapy">Peptide Therapy</option>
          <option value="medical-cannabis">Medical Cannabis</option>
          <option value="general-enquiry">General Enquiry</option>
        </select>
      </div>

      <div class="space-y-2">
        <label for="message" class="text-sm leading-none font-medium">Message <span class="text-destructive">*</span></label>
        <textarea
          id="message"
          name="message"
          placeholder="Tell us about your health goals or ask us a question..."
          class="min-h-[140px] w-full resize-none rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs transition-colors placeholder:text-muted-foreground focus-visible:ring-1 focus-visible:ring-ring focus-visible:outline-none"
          required></textarea>
      </div>

      <div
        class="absolute -left-[9999px] overflow-hidden"
        aria-hidden="true"
      >
        <label for="company_url">Company URL</label>
        <input
          type="text"
          id="company_url"
          name="company_url"
          tabindex={-1}
          autocomplete="off"
        />
      </div>

      <div class="flex items-center justify-between gap-4 pt-2">
        <p class="text-xs text-muted-foreground">
          <span class="text-destructive">*</span> Required fields
        </p>
        <button
          id="submit-btn"
          type="submit"
          class="inline-flex h-10 items-center justify-center rounded-full bg-primary px-8 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus-visible:ring-1 focus-visible:ring-ring focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50"
        >
          Send Enquiry
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  import {
    getStoredUTMParams,
    generateFormToken,
    fireConversionEvents,
  } from "@/lib/tracking";

  const MIN_SUBMIT_TIME_MS = 3000;

  function initContactForm() {
    const form = document.getElementById(
      "contact-form",
    ) as HTMLFormElement | null;
    const btn = document.getElementById(
      "submit-btn",
    ) as HTMLButtonElement | null;
    const errorEl = document.getElementById("form-error") as HTMLElement | null;

    if (!form || !btn || !errorEl) return;

    const loadedAt = Date.now();
    const utm = getStoredUTMParams();
    const ts = Math.floor(Date.now() / 1000);
    const token = generateFormToken(ts);

    function showSuccess() {
      window.location.href = "/thanks";
    }

    function showError(msg: string) {
      errorEl!.textContent = msg;
      errorEl!.hidden = false;
      btn!.disabled = false;
      btn!.textContent = "Send Enquiry";
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(form);

      if (formData.get("company_url")) {
        showSuccess();
        return;
      }

      if (Date.now() - loadedAt < MIN_SUBMIT_TIME_MS) {
        showSuccess();
        return;
      }

      formData.append("_token", token);
      formData.append("_ts", String(ts));
      formData.append("_source", window.location.pathname);

      const utmKeys = [
        "utm_source",
        "utm_medium",
        "utm_campaign",
        "utm_content",
        "utm_term",
        "gclid",
        "fbclid",
      ] as const;
      for (const key of utmKeys) {
        const val = utm[key as keyof typeof utm];
        if (typeof val === "string") formData.append(key, val);
      }
      if (typeof utm.landing_page === "string")
        formData.append("_landing_page", utm.landing_page);

      btn.disabled = true;
      btn.textContent = "Sending...";
      errorEl.hidden = true;

      try {
        const response = await fetch("/api/contact.php", {
          method: "POST",
          body: formData,
        });

        const result = await response.json();

        if (result.success) {
          const name = formData.get("name") as string;
          const email = formData.get("email") as string;
          const phone = formData.get("phone") as string;
          fireConversionEvents({ name, email, phone });
          showSuccess();
        } else {
          showError(
            result.message || "Something went wrong. Please try again.",
          );
        }
      } catch {
        showError(
          "Unable to send your message. Please try again or contact us directly.",
        );
      }
    });
  }

  initContactForm();
  document.addEventListener("astro:after-swap", initContactForm);
</script>
