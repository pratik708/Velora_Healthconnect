---
import { cn } from "@/lib/utils";
import { site } from "@/data/site";

interface MenuItem {
  title: string;
  href: string;
  description?: string;
  icon?: string;
  items?: MenuItem[];
}

interface Props {
  class?: string;
  menu?: MenuItem[];
  cta?: {
    text: string;
    href: string;
  };
}

const {
  class: className,
  menu = [
    {
      title: "Our Services",
      href: "#",
      items: [
        {
          title: "Weight Management",
          description: "Clinically guided programs for sustainable weight loss",
          icon: "chart",
          href: "/services/weight-management",
        },
        {
          title: "Peptide Therapy",
          description: "Evidence-based peptide protocols for performance and wellness",
          icon: "flask",
          href: "/services/peptide-therapy",
        },
        {
          title: "Medical Cannabis",
          description: "TGA-compliant access for chronic pain and wellbeing",
          icon: "heart",
          href: "/services/medical-cannabis",
        },
      ],
    },
    { title: "How It Works", href: "/how-it-works" },
    { title: "About", href: "/about" },
    { title: "FAQ", href: "/faq" },
    { title: "Blog", href: "/blog" },
    { title: "Contact", href: "/contact" },
  ],
  cta = { text: "Book Consultation", href: "/contact" },
} = Astro.props;
---

<!-- Top contact bar -->
<div class="bg-primary text-white/70 text-xs hidden sm:block" id="top-bar">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-9">
      <div class="flex items-center gap-6">
        <a href={`mailto:${site.contact.email}`} class="inline-flex items-center gap-1.5 hover:text-white transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
          {site.contact.email}
        </a>
        <a href={`tel:${site.contact.phone}`} class="inline-flex items-center gap-1.5 hover:text-white transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          {site.contact.phoneDisplay}
        </a>
      </div>
      <div class="hidden md:flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
        <span>TGA & AHPRA Compliant</span>
        <span class="mx-2 text-white/20">|</span>
        <span>Telehealth Australia-wide</span>
      </div>
    </div>
  </div>
</div>

<!-- Main navbar -->
<div class={cn("bg-white/80 backdrop-blur-lg border-b border-border/50 transition-all duration-300", className)} id="main-nav">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <nav class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label={site.name}>
        <svg class="h-9 w-9 shrink-0" viewBox="0 0 40 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="20" cy="24" r="19" fill="oklch(0.55 0.12 175)" opacity="0.08"/>
          <path d="M10 10L20 38L30 10" stroke="oklch(0.55 0.12 175)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M13 22L16 22L17.5 17L20 29L22.5 17L24 22L27 22" stroke="oklch(0.55 0.12 175)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="flex items-baseline gap-0.5 text-xl tracking-tight">
          <span class="font-heading font-extrabold text-primary">Velora</span>
          <span class="font-heading font-medium text-primary/55">Health</span>
          <span class="font-heading font-semibold text-accent">Connect</span>
        </span>
      </a>

      {/* Desktop nav */}
      <div class="hidden items-center gap-0.5 lg:flex">
        {
          menu.map((item) =>
            item.items ? (
              <div class="group relative">
                <button
                  type="button"
                  class="inline-flex h-10 items-center justify-center gap-1.5 rounded-lg px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-primary focus:text-primary focus:outline-none"
                >
                  {item.title}
                  <svg
                    class="size-3.5 text-muted-foreground/60 transition-transform duration-200 group-focus-within:rotate-180 group-hover:rotate-180"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </button>
                <div class="invisible absolute top-full left-1/2 -translate-x-1/2 z-50 pt-3 opacity-0 transition-all duration-200 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                  <div class="w-[420px] rounded-2xl border border-border/60 bg-white p-2 shadow-xl shadow-primary/5">
                    {item.items.map((subItem) => (
                      <a
                        href={subItem.href}
                        class="group/item flex items-start gap-4 rounded-xl p-4 transition-colors hover:bg-accent/5"
                      >
                        <div class="w-10 h-10 rounded-xl bg-accent/8 flex items-center justify-center shrink-0 group-hover/item:bg-accent/15 transition-colors">
                          {subItem.icon === "chart" && (
                            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
                          )}
                          {subItem.icon === "flask" && (
                            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" /></svg>
                          )}
                          {subItem.icon === "heart" && (
                            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
                          )}
                        </div>
                        <div>
                          <p class="font-semibold text-sm text-primary group-hover/item:text-accent transition-colors">
                            {subItem.title}
                          </p>
                          {subItem.description && (
                            <p class="text-xs text-muted-foreground mt-0.5 leading-relaxed">
                              {subItem.description}
                            </p>
                          )}
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class="relative inline-flex h-10 items-center justify-center px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-primary focus:text-primary focus:outline-none group/nav"
              >
                {item.title}
                <span class="absolute bottom-1.5 left-4 right-4 h-0.5 bg-accent rounded-full scale-x-0 group-hover/nav:scale-x-100 transition-transform duration-200 origin-left"></span>
              </a>
            ),
          )
        }
      </div>

      <!-- Right side -->
      <div class="flex items-center gap-3">
        <!-- Phone (desktop) -->
        <a
          href={`tel:${site.contact.phone}`}
          class="hidden xl:inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-primary transition-colors"
        >
          <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          <span class="font-medium">1300 VELORA</span>
        </a>

        <div class="hidden xl:block w-px h-5 bg-border"></div>

        <!-- CTA button -->
        <a
          href={cta.href}
          data-slot="button"
          data-variant="default"
          class="hidden lg:inline-flex group/btn h-10 items-center justify-center gap-2 rounded-full bg-primary px-6 py-2 text-sm font-semibold text-primary-foreground shadow-sm relative overflow-hidden focus-visible:ring-1 focus-visible:ring-ring focus-visible:outline-none"
        >
          {cta.text}
          <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover/btn:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>

        {/* Mobile menu trigger */}
        <button
          type="button"
          id="mobile-menu-trigger"
          class="inline-flex size-10 items-center justify-center rounded-xl border border-border/60 bg-white text-sm font-medium shadow-sm transition-all hover:bg-accent/5 hover:border-accent/30 lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle menu"
        >
          <svg
            class="size-5 text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </nav>
  </div>
</div>

{/* Mobile menu overlay + panel */}
<div
  id="mobile-menu"
  class="fixed inset-0 z-50 hidden lg:hidden"
  aria-modal="true"
  role="dialog"
>
  <div id="mobile-menu-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
  <div
    class="absolute inset-x-0 top-0 max-h-[90vh] overflow-auto bg-white shadow-2xl"
  >
    <!-- Mobile header -->
    <div class="flex items-center justify-between px-5 h-16 border-b border-border/50">
      <a href="/" class="flex items-center gap-2.5" aria-label={site.name}>
        <svg class="h-8 w-8 shrink-0" viewBox="0 0 40 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="20" cy="24" r="19" fill="oklch(0.55 0.12 175)" opacity="0.08"/>
          <path d="M10 10L20 38L30 10" stroke="oklch(0.55 0.12 175)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M13 22L16 22L17.5 17L20 29L22.5 17L24 22L27 22" stroke="oklch(0.55 0.12 175)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="flex items-baseline gap-0.5 text-lg tracking-tight">
          <span class="font-heading font-extrabold text-primary">Velora</span>
          <span class="font-heading font-medium text-primary/55">Health</span>
          <span class="font-heading font-semibold text-accent">Connect</span>
        </span>
      </a>
      <button
        type="button"
        id="mobile-menu-close"
        class="inline-flex size-10 items-center justify-center rounded-xl border border-border/60 bg-white text-sm font-medium shadow-sm transition-all hover:bg-accent/5"
        aria-label="Close menu"
      >
        <svg
          class="size-5 text-primary"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile menu content -->
    <div class="px-5 py-6">
      {/* Services dropdown */}
      {
        menu.filter((item) => item.items).map((item) => (
          <details class="group mb-2">
            <summary class="flex cursor-pointer list-none items-center justify-between rounded-xl px-4 py-3.5 text-base font-semibold text-primary hover:bg-accent/5 transition-colors">
              {item.title}
              <svg
                class="size-4 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="mt-1 ml-4 space-y-1 border-l-2 border-accent/15 pl-4">
              {item.items!.map((subItem) => (
                <a
                  href={subItem.href}
                  class="block rounded-lg px-3 py-2.5 transition-colors hover:bg-accent/5"
                >
                  <p class="font-medium text-sm text-primary">{subItem.title}</p>
                  {subItem.description && (
                    <p class="text-xs text-muted-foreground mt-0.5">{subItem.description}</p>
                  )}
                </a>
              ))}
            </div>
          </details>
        ))
      }

      {/* Nav links */}
      <div class="space-y-1 mt-2">
        {
          menu
            .filter((item) => !item.items)
            .map((item) => (
              <a
                href={item.href}
                class="flex items-center justify-between rounded-xl px-4 py-3.5 text-base font-semibold text-primary hover:bg-accent/5 transition-colors group/mlink"
              >
                {item.title}
                <svg class="w-4 h-4 text-muted-foreground/40 group-hover/mlink:text-accent group-hover/mlink:translate-x-0.5 transition-all" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
              </a>
            ))
        }
      </div>

      <!-- Divider -->
      <div class="my-5 h-px bg-border/60"></div>

      <!-- CTA -->
      <a
        href={cta.href}
        data-slot="button"
        data-variant="default"
        class="group/btn flex h-12 w-full items-center justify-center gap-2 rounded-full bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground shadow-sm relative overflow-hidden"
      >
        {cta.text}
        <svg class="w-4 h-4 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
      </a>

      <!-- Contact info (mobile) -->
      <div class="mt-5 flex flex-col gap-3">
        <a href={`tel:${site.contact.phone}`} class="flex items-center gap-3 text-sm text-muted-foreground hover:text-primary transition-colors">
          <div class="w-9 h-9 rounded-xl bg-accent/8 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          </div>
          {site.contact.phoneDisplay}
        </a>
        <a href={`mailto:${site.contact.email}`} class="flex items-center gap-3 text-sm text-muted-foreground hover:text-primary transition-colors">
          <div class="w-9 h-9 rounded-xl bg-accent/8 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
          </div>
          {site.contact.email}
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  function initMobileMenu() {
    const trigger = document.getElementById("mobile-menu-trigger");
    const menu = document.getElementById("mobile-menu");
    const close = document.getElementById("mobile-menu-close");
    const backdrop = document.getElementById("mobile-menu-backdrop");

    if (!trigger || !menu || !close || !backdrop) return;

    function open() {
      menu!.classList.remove("hidden");
      trigger!.setAttribute("aria-expanded", "true");
      document.body.classList.add("overflow-hidden");
    }

    function shut() {
      menu!.classList.add("hidden");
      trigger!.setAttribute("aria-expanded", "false");
      document.body.classList.remove("overflow-hidden");
    }

    trigger.addEventListener("click", open);
    close.addEventListener("click", shut);
    backdrop.addEventListener("click", shut);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu!.classList.contains("hidden")) shut();
    });
  }

  function initStickyNav() {
    const topBar = document.getElementById("top-bar");
    const mainNav = document.getElementById("main-nav");
    if (!topBar || !mainNav) return;

    function onScroll() {
      const scrollY = window.scrollY;
      if (scrollY > 60) {
        topBar.style.display = "none";
        mainNav.classList.add("shadow-sm");
      } else {
        topBar.style.display = "";
        mainNav.classList.remove("shadow-sm");
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  initMobileMenu();
  initStickyNav();
  document.addEventListener("astro:after-swap", () => {
    initMobileMenu();
    initStickyNav();
  });
</script>
