---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { cn } from "@/lib/utils";
import Button from "@components/astro-ui/Button.astro";

interface Props {
  class?: string;
  heading?: string;
  description?: string;
  image: ImageMetadata;
  cta?: { text: string; href: string };
}

const {
  class: className,
  heading = "Lorem Ipsum \n Dolor Sit Amet.",
  description = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua ut enim ad minim veniam.",
  image,
  cta = { text: "Contact Us", href: "/contact" },
} = Astro.props;
---

<section class={cn("bg-background", className)}>
  <div class="relative mx-auto max-w-7xl px-4 py-32">
    <header class="mx-auto max-w-3xl text-center">
      <h1
        class="font-antonio text-5xl font-semibold text-foreground uppercase md:text-7xl"
      >
        {
          heading.split("\n").map((line, i) => (
            <>
              {i > 0 && <br />}
              {line.trim()}
            </>
          ))
        }
      </h1>
      <p
        class="my-7 max-w-3xl font-sans tracking-tight text-muted-foreground md:text-xl"
      >
        {description}
      </p>
      <Button href={cta.href} size="lg">{cta.text}</Button>
    </header>

    <div class="relative mt-12 overflow-hidden rounded-2xl">
      <Image
        src={image}
        alt=""
        width={1920}
        widths={[640, 1024, 1920]}
        sizes="(max-width: 1280px) 100vw, 1280px"
        loading="eager"
        fetchpriority="high"
        class="aspect-video w-full object-cover"
      />
      <div
        class="absolute bottom-0 h-1/3 w-full bg-linear-to-t from-white to-transparent"
      >
      </div>
    </div>
  </div>
</section>
