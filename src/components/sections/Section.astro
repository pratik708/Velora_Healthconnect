---
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
  id?: string;
  container?: boolean;
  padding?: "none" | "sm" | "md" | "lg" | "xl";
}

const { class: className, id, container = true, padding = "lg" } = Astro.props;

const paddingClasses = {
  none: "",
  sm: "py-8",
  md: "py-12",
  lg: "py-16 md:py-24",
  xl: "py-24 md:py-32",
};
---

<section id={id} class={cn(paddingClasses[padding], className)}>
  {
    container ? (
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <slot />
      </div>
    ) : (
      <slot />
    )
  }
</section>
