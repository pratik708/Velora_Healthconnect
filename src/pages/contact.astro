---
import PageLayout from "@layouts/PageLayout.astro";
import Section from "@components/sections/Section.astro";
import Badge from "@components/astro-ui/Badge.astro";
import ContactForm from "@components/contact-form.astro";
import { site } from "@/data/site";
---

<PageLayout
  title="Contact Us"
  description="Get in touch with Velora HealthConnect. Submit an enquiry, call us, or email our team. We are here to guide you through your health journey."
>
  <!-- ===== HERO ===== -->
  <section class="relative pt-16 pb-12 md:pt-24 md:pb-16 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[oklch(0.965_0.01_230)] via-white to-[oklch(0.96_0.015_175)]"></div>
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <Badge variant="secondary" class="mb-6 bg-[oklch(0.92_0.03_175)] text-[oklch(0.30_0.06_175)]">
        Get in Touch
      </Badge>
      <h1 class="font-heading text-4xl font-extrabold tracking-tight text-primary sm:text-5xl md:text-6xl mb-6">
        We are here to<br class="hidden sm:block" />
        <span class="text-accent">help you get started</span>
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-muted-foreground md:text-xl leading-relaxed">
        Whether you have a question about our services, want to discuss your health goals, or are ready to book a consultation — our team is ready to help.
      </p>
    </div>
  </section>

  <!-- ===== CONTACT INFO CARDS ===== -->
  <Section padding="lg">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-5xl mx-auto mb-16">
      <!-- Phone -->
      <a href={`tel:${site.contact.phone}`} class="group rounded-2xl border border-border p-8 text-center hover:border-accent/30 hover:shadow-xl hover:shadow-accent/5 transition-all duration-300">
        <div class="w-14 h-14 rounded-2xl bg-accent/10 flex items-center justify-center mx-auto mb-5 group-hover:bg-accent/15 transition-colors">
          <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
        </div>
        <h3 class="font-heading text-lg font-bold text-primary mb-2">Call Us</h3>
        <p class="text-accent font-semibold mb-1">{site.contact.phoneDisplay}</p>
        <p class="text-sm text-muted-foreground">Mon - Fri, 9am - 5pm AEST</p>
      </a>

      <!-- Email -->
      <a href={`mailto:${site.contact.email}`} class="group rounded-2xl border border-border p-8 text-center hover:border-accent/30 hover:shadow-xl hover:shadow-accent/5 transition-all duration-300">
        <div class="w-14 h-14 rounded-2xl bg-accent/10 flex items-center justify-center mx-auto mb-5 group-hover:bg-accent/15 transition-colors">
          <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
        </div>
        <h3 class="font-heading text-lg font-bold text-primary mb-2">Email Us</h3>
        <p class="text-accent font-semibold mb-1">{site.contact.email}</p>
        <p class="text-sm text-muted-foreground">We respond within 1 business day</p>
      </a>

      <!-- Telehealth -->
      <div class="group rounded-2xl border border-border p-8 text-center sm:col-span-2 lg:col-span-1 hover:border-accent/30 hover:shadow-xl hover:shadow-accent/5 transition-all duration-300">
        <div class="w-14 h-14 rounded-2xl bg-accent/10 flex items-center justify-center mx-auto mb-5 group-hover:bg-accent/15 transition-colors">
          <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
        </div>
        <h3 class="font-heading text-lg font-bold text-primary mb-2">Australia Wide</h3>
        <p class="text-accent font-semibold mb-1">100% Telehealth</p>
        <p class="text-sm text-muted-foreground">Consultations available nationally via secure video or phone</p>
      </div>
    </div>

    <!-- ===== FORM + SIDEBAR ===== -->
    <div class="grid lg:grid-cols-[1fr_380px] gap-12 lg:gap-16 max-w-6xl mx-auto">
      <!-- Form -->
      <div>
        <ContactForm />
      </div>

      <!-- Sidebar -->
      <div class="space-y-8">
        <!-- What happens next -->
        <div class="rounded-2xl border border-border p-6">
          <h3 class="font-heading font-bold text-primary mb-4">What happens after you enquire?</h3>
          <div class="space-y-4">
            <div class="flex gap-3">
              <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center flex-shrink-0">
                <span class="text-sm font-bold text-accent">1</span>
              </div>
              <div>
                <p class="font-semibold text-sm text-primary">We review your enquiry</p>
                <p class="text-sm text-muted-foreground">Our team reviews your details within 1 business day.</p>
              </div>
            </div>
            <div class="flex gap-3">
              <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center flex-shrink-0">
                <span class="text-sm font-bold text-accent">2</span>
              </div>
              <div>
                <p class="font-semibold text-sm text-primary">We get in touch</p>
                <p class="text-sm text-muted-foreground">We contact you to discuss your goals and schedule a consultation.</p>
              </div>
            </div>
            <div class="flex gap-3">
              <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center flex-shrink-0">
                <span class="text-sm font-bold text-accent">3</span>
              </div>
              <div>
                <p class="font-semibold text-sm text-primary">Your consultation begins</p>
                <p class="text-sm text-muted-foreground">Speak with an Australian-registered prescriber via secure telehealth.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Trust signals -->
        <div class="rounded-2xl bg-secondary/50 p-6">
          <h3 class="font-heading font-bold text-primary mb-4">Why patients trust us</h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-sm text-muted-foreground">
              <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              <span>Australian-registered medical practitioners</span>
            </li>
            <li class="flex items-start gap-3 text-sm text-muted-foreground">
              <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              <span>TGA and AHPRA compliant</span>
            </li>
            <li class="flex items-start gap-3 text-sm text-muted-foreground">
              <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              <span>Genuine follow-up care with every patient</span>
            </li>
            <li class="flex items-start gap-3 text-sm text-muted-foreground">
              <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              <span>Secure, private consultations</span>
            </li>
            <li class="flex items-start gap-3 text-sm text-muted-foreground">
              <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              <span>No obligation to proceed after your enquiry</span>
            </li>
          </ul>
        </div>

        <!-- Direct contact -->
        <div class="rounded-2xl border-2 border-accent/20 bg-accent/5 p-6">
          <h3 class="font-heading font-bold text-primary mb-2">Prefer to speak with someone?</h3>
          <p class="text-sm text-muted-foreground mb-4">
            Call our team directly and we will help you get started over the phone.
          </p>
          <a
            href={`tel:${site.contact.phone}`}
            class="inline-flex items-center gap-2 text-sm font-semibold text-accent hover:text-accent/80 transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
            {site.contact.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </Section>

  <!-- ===== DISCLAIMER ===== -->
  <div class="border-t border-border">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
      <p class="text-xs text-muted-foreground leading-relaxed text-center">
        Disclaimer: The information provided on this website is for general informational purposes only and does not constitute medical advice. All treatments are subject to medical assessment and clinical suitability. Results may vary between individuals. Velora HealthConnect operates in accordance with TGA regulations and AHPRA guidelines.
      </p>
    </div>
  </div>
</PageLayout>
