---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Badge from "@components/astro-ui/Badge.astro";
import Button from "@components/astro-ui/Button.astro";
import { Image } from "astro:assets";
import { site } from "@/data/site";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = sortedPosts[0];
const remainingPosts = sortedPosts.slice(1);

// Collect all unique tags
const allTags = [...new Set(sortedPosts.flatMap((post) => post.data.tags))].sort();

// Estimated reading time helper
function getReadingTime(body: string): number {
  const words = body.split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
}
---

<PageLayout
  title="Blog"
  description="Expert insights on weight management, peptide therapy, medical cannabis, and telehealth from the Velora HealthConnect team. Evidence-based articles to support your health journey."
>
  <!-- ===== HERO ===== -->
  <section class="relative pt-16 pb-12 md:pt-24 md:pb-16 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[oklch(0.965_0.01_230)] via-white to-[oklch(0.96_0.015_175)]"></div>
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <Badge variant="secondary" class="mb-6 bg-[oklch(0.92_0.03_175)] text-[oklch(0.30_0.06_175)]">
        Health Insights
      </Badge>
      <h1 class="font-heading text-4xl font-extrabold tracking-tight text-primary sm:text-5xl md:text-6xl mb-6">
        Expert guidance for<br class="hidden sm:block" />
        <span class="text-accent">your health journey</span>
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-muted-foreground md:text-xl leading-relaxed">
        Evidence-based articles from our medical team on weight management, peptide therapy, medical cannabis, and the importance of ongoing care.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24">

    {/* ===== FEATURED POST ===== */}
    {featuredPost && (
      <a href={`/Velora_Healthconnect/blog/${featuredPost.id}`} class="group block mb-16 md:mb-20">
        <article class="grid md:grid-cols-2 gap-8 md:gap-12 items-center rounded-3xl border border-border p-6 md:p-10 hover:border-accent/30 hover:shadow-2xl hover:shadow-accent/5 transition-all duration-300">
          {/* Featured image */}
          <div class="aspect-[16/10] rounded-2xl bg-gradient-to-br from-[oklch(0.94_0.02_230)] to-[oklch(0.92_0.04_175)] overflow-hidden">
            {featuredPost.data.image ? (
              <Image
                src={featuredPost.data.image}
                alt={featuredPost.data.title}
                class="w-full h-full object-cover"
                width={640}
                height={400}
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-accent/15">
                <svg class="w-24 h-24" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              </div>
            )}
          </div>

          <div>
            <div class="flex items-center gap-3 mb-4">
              <Badge variant="secondary" class="bg-accent/10 text-accent">Featured</Badge>
              {featuredPost.data.tags[0] && (
                <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">{featuredPost.data.tags[0]}</span>
              )}
            </div>

            <h2 class="font-heading text-2xl font-bold text-primary sm:text-3xl mb-4 group-hover:text-accent transition-colors">
              {featuredPost.data.title}
            </h2>

            <p class="text-muted-foreground leading-relaxed mb-6 line-clamp-3">
              {featuredPost.data.description}
            </p>

            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center">
                  <span class="text-sm font-bold text-accent">
                    {featuredPost.data.author.split(" ").map((n: string) => n[0]).join("").slice(0, 2)}
                  </span>
                </div>
                <div>
                  <p class="text-sm font-semibold text-primary">{featuredPost.data.author}</p>
                  <p class="text-xs text-muted-foreground">
                    {featuredPost.data.pubDate.toLocaleDateString("en-AU", { dateStyle: "medium" })}
                    <span class="mx-1.5">&middot;</span>
                    {getReadingTime(featuredPost.body || "")} min read
                  </p>
                </div>
              </div>

              <span class="hidden sm:inline-flex items-center gap-2 text-sm font-semibold text-accent group-hover:gap-3 transition-all">
                Read article
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
              </span>
            </div>
          </div>
        </article>
      </a>
    )}

    {/* ===== TAG FILTER ===== */}
    {allTags.length > 0 && (
      <div class="flex flex-wrap items-center gap-2 mb-10">
        <span class="text-sm font-medium text-muted-foreground mr-2">Browse by topic:</span>
        {allTags.map((tag) => (
          <span class="rounded-full border border-border px-3 py-1 text-xs font-medium text-muted-foreground hover:border-accent/30 hover:text-accent cursor-default transition-colors">
            {tag}
          </span>
        ))}
      </div>
    )}

    {/* ===== POST GRID ===== */}
    {remainingPosts.length > 0 && (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {remainingPosts.map((post) => (
          <a href={`/Velora_Healthconnect/blog/${post.id}`} class="group block">
            <article class="h-full flex flex-col rounded-2xl border border-border overflow-hidden hover:border-accent/30 hover:shadow-xl hover:shadow-accent/5 transition-all duration-300">
              {/* Card image */}
              <div class="aspect-[16/9] bg-gradient-to-br from-[oklch(0.95_0.01_230)] to-[oklch(0.93_0.03_175)] relative overflow-hidden">
                {post.data.image ? (
                  <Image
                    src={post.data.image}
                    alt={post.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    width={480}
                    height={270}
                  />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center text-accent/10">
                    <svg class="w-16 h-16" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                  </div>
                )}
                {/* Tag overlay */}
                {post.data.tags[0] && (
                  <div class="absolute top-4 left-4">
                    <span class="rounded-full bg-white/90 backdrop-blur px-3 py-1 text-xs font-semibold text-primary shadow-sm">
                      {post.data.tags[0]}
                    </span>
                  </div>
                )}
              </div>

              <div class="flex flex-col flex-1 p-6">
                <h3 class="font-heading text-lg font-bold text-primary mb-3 group-hover:text-accent transition-colors line-clamp-2">
                  {post.data.title}
                </h3>

                <p class="text-sm text-muted-foreground leading-relaxed mb-6 line-clamp-3 flex-1">
                  {post.data.description}
                </p>

                <div class="flex items-center justify-between pt-4 border-t border-border">
                  <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-full bg-accent/10 flex items-center justify-center">
                      <span class="text-xs font-bold text-accent">
                        {post.data.author.split(" ").map((n: string) => n[0]).join("").slice(0, 2)}
                      </span>
                    </div>
                    <div>
                      <p class="text-xs font-semibold text-primary">{post.data.author}</p>
                      <p class="text-xs text-muted-foreground">
                        {post.data.pubDate.toLocaleDateString("en-AU", { dateStyle: "medium" })}
                      </p>
                    </div>
                  </div>
                  <span class="text-xs text-muted-foreground">{getReadingTime(post.body || "")} min read</span>
                </div>
              </div>
            </article>
          </a>
        ))}
      </div>
    )}

    {/* ===== EMPTY STATE ===== */}
    {sortedPosts.length === 0 && (
      <div class="text-center py-20">
        <div class="w-16 h-16 rounded-2xl bg-accent/10 flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
        </div>
        <h2 class="font-heading text-xl font-bold text-primary mb-2">No posts yet</h2>
        <p class="text-muted-foreground">Check back soon — we are working on our first articles.</p>
      </div>
    )}
  </div>

  <!-- ===== NEWSLETTER / CTA ===== -->
  <section class="py-16 md:py-24 bg-primary">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center mx-auto mb-6">
        <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
      </div>
      <h2 class="font-heading text-3xl font-bold tracking-tight text-white sm:text-4xl mb-4">
        Have a question about your health?
      </h2>
      <p class="text-lg text-[oklch(0.70_0.03_230)] leading-relaxed mb-8">
        Our team is here to provide trusted guidance. Reach out for a confidential conversation about your health goals.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/Velora_Healthconnect/contact"
          class="group/btn inline-flex h-12 items-center justify-center gap-2.5 rounded-full bg-white px-8 text-sm font-semibold text-primary shadow-sm transition-all duration-300 hover:bg-white/90 hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] relative overflow-hidden"
        >
          Get in Touch
          <svg class="w-4 h-4 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a
          href={`tel:${site.contact.phone}`}
          class="group/btn inline-flex h-12 items-center justify-center gap-2.5 rounded-full border border-white/20 px-8 text-sm font-semibold text-white transition-all duration-300 hover:bg-white/10 hover:border-white/40 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          Call {site.contact.phoneDisplay}
        </a>
      </div>
    </div>
  </section>
</PageLayout>
