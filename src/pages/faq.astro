---
import PageLayout from "@layouts/PageLayout.astro";
import Badge from "@components/astro-ui/Badge.astro";
import Button from "@components/astro-ui/Button.astro";
import { site } from "@/data/site";

const tabs = [
  {
    id: "general",
    label: "General",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" /></svg>`,
    questions: [
      {
        q: "What is Velora HealthConnect?",
        a: "Velora HealthConnect is an Australian telehealth clinic that provides expert consultations for weight management, peptide therapy, and medical cannabis. We connect you with registered prescribers via secure video consultations, with a focus on genuine follow-up care — not just one-off prescriptions.",
      },
      {
        q: "Who are your prescribers?",
        a: "All Velora HealthConnect prescribers are Australian-registered medical professionals with specialised training in their treatment areas. They are fully qualified to assess, prescribe, and monitor your treatment within Australia's regulatory frameworks.",
      },
      {
        q: "Is telehealth as effective as in-person care?",
        a: "For consultation-based services like ours — where the clinical decision-making relies on your medical history, symptoms, and goals rather than physical examination — research consistently shows telehealth delivers outcomes comparable to in-person care. Our prescribers will always refer you for in-person assessment if the clinical situation requires it.",
      },
      {
        q: "Do I need a referral from my GP?",
        a: "No GP referral is required for most of our services. You can book a consultation directly through our website. However, we may request relevant medical records or recommend you speak with your GP as part of a collaborative approach to your care.",
      },
      {
        q: "What areas of Australia do you service?",
        a: "We service patients across all of Australia. Because our consultations are conducted via telehealth, your location does not limit your access to care — whether you are in a capital city or a regional area.",
      },
      {
        q: "How do I book a consultation?",
        a: "You can submit an enquiry through our contact page or call us directly on 1300 VELORA (1300 835 672). Our team will get in touch to schedule your initial consultation at a time that works for you.",
      },
    ],
  },
  {
    id: "treatment",
    label: "Treatments",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" /></svg>`,
    questions: [
      {
        q: "What treatments do you offer?",
        a: "We specialise in three treatment areas: weight management (including GLP-1 receptor agonist medications), peptide therapy (for performance, recovery, and wellbeing), and medical cannabis (TGA-compliant access for eligible conditions). Each treatment is prescribed and monitored by a registered prescriber.",
      },
      {
        q: "How do I know which treatment is right for me?",
        a: "Your prescriber will conduct a thorough assessment during your initial consultation, reviewing your medical history, current health, goals, and suitability for treatment. They will recommend the most appropriate option — or explain why a particular treatment may not be suitable for you.",
      },
      {
        q: "What are GLP-1 medications for weight loss?",
        a: "GLP-1 receptor agonists (such as semaglutide and tirzepatide) are prescription medications that help regulate appetite and blood sugar levels. They are clinically proven to support significant, sustained weight loss when combined with lifestyle changes and medical supervision. Our prescribers will assess whether these medications are appropriate for your situation.",
      },
      {
        q: "Is medical cannabis legal in Australia?",
        a: "Yes. Medical cannabis is legal in Australia when prescribed by an authorised prescriber through TGA-approved pathways. Velora HealthConnect follows all regulatory requirements, including the Therapeutic Goods Administration (TGA) Special Access Scheme and Authorised Prescriber framework.",
      },
      {
        q: "What conditions qualify for medical cannabis?",
        a: "Medical cannabis may be considered for a range of conditions including chronic pain, anxiety, insomnia, PTSD, epilepsy, and certain neurological conditions — where conventional treatments have been tried and found insufficient. Your prescriber will assess your eligibility based on your specific circumstances and medical history.",
      },
      {
        q: "What is peptide therapy used for?",
        a: "Peptide therapy involves the use of specific peptide compounds to support various health goals including muscle recovery, improved sleep quality, enhanced vitality, and general wellbeing. All peptide treatments are evidence-based and prescribed under medical supervision.",
      },
    ],
  },
  {
    id: "process",
    label: "Process & Care",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`,
    questions: [
      {
        q: "What happens during the initial consultation?",
        a: "Your prescriber will review your medical history, discuss your health goals, assess your suitability for treatment, and answer any questions you have. If treatment is appropriate, they will develop a personalised care plan including medication, dosage, monitoring schedule, and follow-up appointments.",
      },
      {
        q: "How long does a consultation take?",
        a: "Initial consultations typically last 15 to 30 minutes, depending on your treatment area and complexity. We never rush — your prescriber will take the time needed to properly assess your suitability and answer all your questions.",
      },
      {
        q: "What do I need for my consultation?",
        a: "You will need a valid photo ID (driver's licence, passport, or government-issued ID), a list of current medications and relevant medical history, and a private space with a reliable internet connection and a device with camera and microphone.",
      },
      {
        q: "How quickly will I receive my medication?",
        a: "Once approved, prescriptions are processed promptly. Delivery times depend on your location and the specific medication, but most patients receive their treatment within a few business days. We will keep you informed throughout the process.",
      },
      {
        q: "What if I am not approved for treatment?",
        a: "Not every patient will be clinically suitable for every treatment. If your prescriber determines that a particular treatment is not appropriate for you, they will explain why and, where possible, recommend alternative options or refer you to another healthcare provider.",
      },
      {
        q: "How often are follow-up appointments?",
        a: "Follow-up frequency depends on your treatment plan. Typically, patients have a check-in within the first few weeks of starting treatment, then at regular intervals determined by your prescriber. We maintain a 100% patient follow-up rate — no one falls through the cracks.",
      },
    ],
  },
  {
    id: "pricing",
    label: "Pricing & Privacy",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" /></svg>`,
    questions: [
      {
        q: "How much do consultations cost?",
        a: "Consultation fees vary depending on the type of appointment and treatment area. We are transparent about our pricing — our team will provide you with a clear breakdown of costs before your first appointment so there are no surprises.",
      },
      {
        q: "Can I claim through Medicare or private health insurance?",
        a: "Telehealth consultations may be eligible for Medicare rebates depending on the type of consultation and your circumstances. Some private health insurers also cover telehealth consultations. We recommend checking with your insurer for specific details regarding your plan.",
      },
      {
        q: "Are medication costs included in the consultation fee?",
        a: "No, medication costs are separate from the consultation fee. The cost of your medication will depend on the specific treatment prescribed. Your prescriber will discuss the expected medication costs during your consultation so you can make an informed decision.",
      },
      {
        q: "Is my personal information kept private?",
        a: "Absolutely. We take your privacy extremely seriously. All consultations are conducted via secure, encrypted video platforms. Your medical records are stored in compliance with Australian privacy legislation, and your information is never shared with third parties without your explicit consent.",
      },
      {
        q: "Can I cancel or reschedule my appointment?",
        a: "Yes, you can reschedule or cancel your appointment by contacting our team. We ask for reasonable notice so we can offer the time slot to another patient. Contact us by phone or email to make any changes to your scheduled appointment.",
      },
      {
        q: "Can I contact someone between appointments?",
        a: "Absolutely. Our dedicated support team is available by phone and email for any questions or concerns between scheduled appointments. You are never left in the dark — this is a core part of the Velora HealthConnect difference.",
      },
    ],
  },
];
---

<PageLayout
  title="Frequently Asked Questions"
  description="Find answers to common questions about Velora HealthConnect's telehealth services, treatment options, the consultation process, pricing, and patient privacy."
>
  <!-- ===== HERO ===== -->
  <section class="relative pt-16 pb-12 md:pt-24 md:pb-16 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[oklch(0.965_0.01_230)] via-white to-[oklch(0.96_0.015_175)]"></div>
    <div class="absolute top-10 right-0 w-[400px] h-[400px] bg-[oklch(0.92_0.04_175/0.25)] rounded-full blur-[100px]"></div>
    <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-[oklch(0.94_0.02_230/0.2)] rounded-full blur-[80px]"></div>

    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <Badge variant="secondary" class="mb-6 bg-[oklch(0.92_0.03_175)] text-[oklch(0.30_0.06_175)]">
        FAQs
      </Badge>
      <h1 class="font-heading text-4xl font-extrabold tracking-tight text-primary sm:text-5xl md:text-6xl mb-6">
        Questions?<br class="hidden sm:block" />
        <span class="text-accent">We have answers</span>
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-muted-foreground md:text-xl leading-relaxed">
        Everything you need to know about our telehealth services, treatments, and how we look after our patients.
      </p>

      <!-- Search hint -->
      <div class="mt-8 mx-auto max-w-md">
        <div class="flex items-center gap-3 rounded-full border border-border bg-white px-5 py-3 shadow-sm">
          <svg class="w-5 h-5 text-muted-foreground flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
          <span class="text-sm text-muted-foreground">Browse by topic below or <a href="/Velora_Healthconnect/contact" class="text-accent font-semibold hover:underline">ask us directly</a></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FAQ TABS ===== -->
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

      <!-- Tab buttons -->
      <div class="flex justify-center mb-12">
        <div class="inline-flex flex-wrap justify-center gap-2 rounded-2xl bg-[oklch(0.97_0.005_230)] p-2" role="tablist" aria-label="FAQ categories">
          {tabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${tab.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`panel-${tab.id}`}
              data-tab={tab.id}
              class:list={[
                "faq-tab group relative flex items-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold transition-all duration-300 cursor-pointer",
                i === 0
                  ? "bg-white text-primary shadow-md shadow-accent/10"
                  : "text-muted-foreground hover:text-primary hover:bg-white/60",
              ]}
            >
              <span class:list={[
                "transition-colors duration-300",
                i === 0 ? "text-accent" : "text-muted-foreground group-hover:text-accent",
              ]} set:html={tab.icon} />
              {tab.label}
              {i === 0 && (
                <span class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-6 h-1 rounded-full bg-accent"></span>
              )}
            </button>
          ))}
        </div>
      </div>

      <!-- Tab panels -->
      {tabs.map((tab, i) => (
        <div
          id={`panel-${tab.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${tab.id}`}
          class:list={["faq-panel", i !== 0 && "hidden"]}
          data-panel={tab.id}
        >
          <!-- Category header -->
          <div class="flex items-center gap-3 mb-8">
            <div class="w-10 h-10 rounded-xl bg-accent/10 flex items-center justify-center text-accent" set:html={tab.icon} />
            <div>
              <h2 class="font-heading text-xl font-bold text-primary">{tab.label}</h2>
              <p class="text-sm text-muted-foreground">{tab.questions.length} questions</p>
            </div>
          </div>

          <!-- Questions -->
          <div class="space-y-4">
            {tab.questions.map((faq, qi) => (
              <details class="group rounded-2xl border border-border overflow-hidden hover:border-accent/20 transition-colors duration-300">
                <summary class="flex items-center justify-between p-6 cursor-pointer list-none select-none">
                  <div class="flex items-center gap-4 pr-4">
                    <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-[oklch(0.97_0.005_230)] group-open:bg-accent/10 flex items-center justify-center text-xs font-bold text-muted-foreground group-open:text-accent transition-colors duration-300">
                      {String(qi + 1).padStart(2, "0")}
                    </span>
                    <h3 class="font-heading font-semibold text-primary text-left">{faq.q}</h3>
                  </div>
                  <div class="flex-shrink-0 w-8 h-8 rounded-full border border-border group-open:border-accent/30 group-open:bg-accent/10 flex items-center justify-center transition-all duration-300">
                    <svg class="w-4 h-4 text-muted-foreground group-open:text-accent transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                  </div>
                </summary>
                <div class="px-6 pb-6 pl-[4.5rem]">
                  <p class="text-muted-foreground leading-relaxed">{faq.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ===== STILL HAVE QUESTIONS ===== -->
  <section class="py-16 md:py-24 border-t border-border">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-sm font-semibold text-accent uppercase tracking-wider mb-3">Still have questions?</p>
        <h2 class="font-heading text-3xl font-bold tracking-tight text-primary sm:text-4xl mb-4">
          We are here to help
        </h2>
        <p class="mx-auto max-w-2xl text-muted-foreground leading-relaxed">
          Cannot find what you are looking for? Our team is happy to answer any questions you have about our services, treatments, or the process.
        </p>
      </div>

      <div class="grid sm:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <!-- Call -->
        <a href={`tel:${site.contact.phone}`} class="group rounded-2xl border border-border p-8 text-center hover:border-accent/30 hover:shadow-xl hover:shadow-accent/5 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-accent/10 flex items-center justify-center mx-auto mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-primary mb-2">Call Us</h3>
          <p class="text-sm text-muted-foreground mb-3">Speak with our team directly</p>
          <span class="text-sm font-semibold text-accent">{site.contact.phoneDisplay}</span>
        </a>

        <!-- Email -->
        <a href={`mailto:${site.contact.email}`} class="group rounded-2xl border border-border p-8 text-center hover:border-accent/30 hover:shadow-xl hover:shadow-accent/5 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-accent/10 flex items-center justify-center mx-auto mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-primary mb-2">Email Us</h3>
          <p class="text-sm text-muted-foreground mb-3">We will respond within 24 hours</p>
          <span class="text-sm font-semibold text-accent">{site.contact.email}</span>
        </a>

        <!-- Book -->
        <a href="/Velora_Healthconnect/contact" class="group rounded-2xl border border-border p-8 text-center hover:border-accent/30 hover:shadow-xl hover:shadow-accent/5 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-accent/10 flex items-center justify-center mx-auto mb-5 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-primary mb-2">Book a Consultation</h3>
          <p class="text-sm text-muted-foreground mb-3">Start your health journey</p>
          <span class="text-sm font-semibold text-accent">Get in touch &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="relative py-16 md:py-24 bg-primary overflow-hidden">
    <div class="absolute top-0 left-1/4 w-[400px] h-[400px] bg-accent/10 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-0 right-1/4 w-[300px] h-[300px] bg-[oklch(0.4_0.08_230/0.15)] rounded-full blur-[100px]"></div>

    <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center mx-auto mb-6">
        <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
      </div>
      <h2 class="font-heading text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl mb-4">
        Ready to start your health journey?
      </h2>
      <p class="text-lg text-[oklch(0.70_0.03_230)] leading-relaxed mb-8 max-w-xl mx-auto">
        Our team of Australian-registered prescribers is here to provide trusted guidance and genuine follow-up care.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/Velora_Healthconnect/contact"
          class="group/btn inline-flex h-12 items-center justify-center gap-2.5 rounded-full bg-white px-8 text-sm font-semibold text-primary shadow-sm transition-all duration-300 hover:bg-white/90 hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] relative overflow-hidden"
        >
          Book a Consultation
          <svg class="w-4 h-4 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a
          href={`tel:${site.contact.phone}`}
          class="group/btn inline-flex h-12 items-center justify-center gap-2.5 rounded-full border border-white/20 px-8 text-sm font-semibold text-white transition-all duration-300 hover:bg-white/10 hover:border-white/40 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          Call {site.contact.phoneDisplay}
        </a>
      </div>
    </div>
  </section>

  <!-- JSON-LD FAQ structured data -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: tabs.flatMap((tab) =>
        tab.questions.map((faq) => ({
          "@type": "Question",
          name: faq.q,
          acceptedAnswer: {
            "@type": "Answer",
            text: faq.a,
          },
        })),
      ),
    })}
  />
</PageLayout>

<script>
  function initFaqTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>(".faq-tab");
    const panels = document.querySelectorAll<HTMLElement>(".faq-panel");

    if (!tabs.length || !panels.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const targetId = tab.dataset.tab;

        // Update tab states
        tabs.forEach((t) => {
          const isActive = t.dataset.tab === targetId;
          t.setAttribute("aria-selected", isActive ? "true" : "false");

          // Style active tab
          if (isActive) {
            t.classList.add("bg-white", "text-primary", "shadow-md", "shadow-accent/10");
            t.classList.remove("text-muted-foreground", "hover:text-primary", "hover:bg-white/60");
            // Add indicator dot
            if (!t.querySelector(".tab-indicator")) {
              const indicator = document.createElement("span");
              indicator.className = "tab-indicator absolute -bottom-2 left-1/2 -translate-x-1/2 w-6 h-1 rounded-full bg-accent";
              t.appendChild(indicator);
            }
            // Update icon color
            const iconSpan = t.querySelector("span:first-child");
            if (iconSpan) {
              iconSpan.classList.add("text-accent");
              iconSpan.classList.remove("text-muted-foreground");
            }
          } else {
            t.classList.remove("bg-white", "text-primary", "shadow-md", "shadow-accent/10");
            t.classList.add("text-muted-foreground", "hover:text-primary", "hover:bg-white/60");
            // Remove indicator dot
            const indicator = t.querySelector(".tab-indicator");
            if (indicator) indicator.remove();
            // Update icon color
            const iconSpan = t.querySelector("span:first-child");
            if (iconSpan) {
              iconSpan.classList.remove("text-accent");
              iconSpan.classList.add("text-muted-foreground");
            }
          }
        });

        // Show/hide panels
        panels.forEach((panel) => {
          if (panel.dataset.panel === targetId) {
            panel.classList.remove("hidden");
          } else {
            panel.classList.add("hidden");
          }
        });
      });
    });
  }

  initFaqTabs();
  document.addEventListener("astro:after-swap", initFaqTabs);
</script>
