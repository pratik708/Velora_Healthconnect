            <p class="text-sm font-semibold text-accent uppercase tracking-wider mb-3">Latest Insights</p>
            <h2 class="font-heading text-3xl font-bold tracking-tight text-primary sm:text-4xl">
              From our health blog
            </h2>
          </div>
          <a href="/blog" class="hidden sm:inline-flex items-center gap-2 text-sm font-semibold text-accent hover:text-accent/80 transition-colors">
            View all articles
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </a>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {latestPosts.map((post) => (
            <a href={`/blog/${post.id}`} class="group block">
              <article class="h-full flex flex-col rounded-2xl border border-border overflow-hidden bg-white hover:shadow-xl hover:shadow-accent/5 hover:-translate-y-0.5 transition-all duration-300">
                <div class="aspect-[16/9] bg-gradient-to-br from-[oklch(0.95_0.01_230)] to-[oklch(0.93_0.03_175)] relative overflow-hidden">
                  {post.data.image ? (
                    <Image
                      src={post.data.image}
                      alt={post.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      width={480}
                      height={270}
                    />
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center text-accent/10">
                      <svg class="w-14 h-14" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
                    </div>
                  )}
                  {post.data.tags[0] && (
                    <div class="absolute top-4 left-4">
                      <span class="rounded-full bg-white/90 backdrop-blur px-3 py-1 text-xs font-semibold text-primary shadow-sm">
                        {post.data.tags[0]}
                      </span>
                    </div>
                  )}
                </div>
                <div class="flex flex-col flex-1 p-6">
                  <h3 class="font-heading text-lg font-bold text-primary mb-2 group-hover:text-accent transition-colors line-clamp-2">
                    {post.data.title}
                  </h3>
                  <p class="text-sm text-muted-foreground leading-relaxed line-clamp-2 flex-1 mb-4">
                    {post.data.description}
                  </p>
                  <p class="text-xs text-muted-foreground">
                    {post.data.pubDate.toLocaleDateString("en-AU", { dateStyle: "medium" })}
                  </p>
                </div>
              </article>
            </a>
          ))}
        </div>

        <div class="text-center mt-10 sm:hidden">
          <Button href="/blog" variant="outline">View all articles</Button>
        </div>
      </div>
    </section>
  )}

  <!-- ===== FAQ ===== -->
  <section id="faq" class="py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <p class="text-sm font-semibold text-accent uppercase tracking-wider mb-3">FAQs</p>
        <h2 class="font-heading text-3xl font-bold tracking-tight text-primary sm:text-4xl mb-4">
          Common questions
        </h2>
        <p class="text-lg text-muted-foreground">
          Everything you need to know about getting started with Velora HealthConnect.
        </p>
      </div>

      <div class="space-y-3">
        <details class="group rounded-2xl border border-border overflow-hidden hover:border-accent/20 transition-colors">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <h3 class="font-heading font-semibold text-primary pr-4">How does a telehealth consultation work?</h3>
            <svg class="w-5 h-5 text-muted-foreground flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-6 pb-6 text-muted-foreground leading-relaxed">
            After submitting your enquiry form, you will be matched with an Australian-registered prescriber. Your consultation takes place via a secure video or phone call at a time that suits you. The prescriber will review your health history, discuss your goals, and recommend a treatment plan if clinically appropriate.
          </div>
        </details>

        <details class="group rounded-2xl border border-border overflow-hidden hover:border-accent/20 transition-colors">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <h3 class="font-heading font-semibold text-primary pr-4">Is medical cannabis legal in Australia?</h3>
            <svg class="w-5 h-5 text-muted-foreground flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-6 pb-6 text-muted-foreground leading-relaxed">
            Yes. Medical cannabis has been legal in Australia since 2016 when prescribed by an authorised prescriber via the TGA's Special Access Scheme or Authorised Prescriber pathway. A valid prescription from a registered medical practitioner is required. Velora HealthConnect follows all TGA and AHPRA guidelines.
          </div>
        </details>

        <details class="group rounded-2xl border border-border overflow-hidden hover:border-accent/20 transition-colors">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <h3 class="font-heading font-semibold text-primary pr-4">What makes Velora different from other telehealth providers?</h3>
            <svg class="w-5 h-5 text-muted-foreground flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-6 pb-6 text-muted-foreground leading-relaxed">
            Our core difference is genuine follow-up care. While many providers focus primarily on the prescription, we provide scheduled check-ins, dedicated support between appointments, and ongoing treatment monitoring. We believe the prescription is the beginning of the journey, not the end.
          </div>
        </details>

        <details class="group rounded-2xl border border-border overflow-hidden hover:border-accent/20 transition-colors">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <h3 class="font-heading font-semibold text-primary pr-4">Who are your prescribers?</h3>
            <svg class="w-5 h-5 text-muted-foreground flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-6 pb-6 text-muted-foreground leading-relaxed">
            All consultations are conducted by Australian-registered medical practitioners (AHPRA registered). Our prescribers have experience in the specific treatment areas we offer and are committed to patient-centred care.
          </div>
        </details>

        <details class="group rounded-2xl border border-border overflow-hidden hover:border-accent/20 transition-colors">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <h3 class="font-heading font-semibold text-primary pr-4">How much does a consultation cost?</h3>
            <svg class="w-5 h-5 text-muted-foreground flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-6 pb-6 text-muted-foreground leading-relaxed">
            Consultation fees vary depending on the service. We are transparent about all costs upfront and there are no hidden fees. Contact our team for current pricing on weight management, peptide therapy, or medical cannabis consultations.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-[oklch(0.965_0.01_230)] to-[oklch(0.96_0.015_175)] relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-accent/5 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-primary/5 rounded-full translate-y-1/2 -translate-x-1/2 blur-3xl"></div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-heading text-3xl font-bold tracking-tight text-primary sm:text-4xl lg:text-5xl mb-4">
        Ready to start your health journey?
      </h2>
      <p class="text-lg text-muted-foreground leading-relaxed mb-8 max-w-2xl mx-auto">
        Reach out to our team to discuss your health goals. We are here to guide you through the process and answer any questions — with genuine follow-up care at every step.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" data-slot="button" data-variant="default" data-size="lg" class="group/btn inline-flex h-12 items-center justify-center gap-2.5 rounded-full bg-primary px-8 text-sm font-semibold text-primary-foreground shadow-sm relative overflow-hidden">
          Book a Consultation
          <svg class="w-4 h-4 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a href={`tel:${site.contact.phone}`} data-slot="button" data-variant="outline" data-size="lg" class="group/btn inline-flex h-12 items-center justify-center gap-2.5 rounded-full border border-border/60 bg-background px-8 text-sm font-semibold relative overflow-hidden">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          Call {site.contact.phoneDisplay}
        </a>
      </div>
    </div>
  </section>

  <!-- ===== DISCLAIMER ===== -->
  <div class="border-t border-border">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
      <p class="text-xs text-muted-foreground leading-relaxed text-center">
        Disclaimer: The information provided on this website is for general informational purposes only and does not constitute medical advice. All treatments are subject to medical assessment and clinical suitability. Results may vary between individuals. Velora HealthConnect operates in accordance with TGA regulations and AHPRA guidelines. Always consult your healthcare provider before starting any new treatment.
      </p>
    </div>
  </div>

</PageLayout>
