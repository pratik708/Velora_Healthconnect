---
import PageLayout from "@layouts/PageLayout.astro";
import Section from "@components/sections/Section.astro";
import Button from "@components/astro-ui/Button.astro";
import Badge from "@components/astro-ui/Badge.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { site } from "@/data/site";

import heroImage from "@assets/images/site/hero-telehealth.jpg";
import serviceWeightImg from "@assets/images/site/weight-management.jpg";
import servicePeptideImg from "@assets/images/site/peptide-therapy.jpg";
import serviceCannabisImg from "@assets/images/site/medical-consultation.jpg";
import veloraDiffImg from "@assets/images/site/patient-care.jpg";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const latestPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<PageLayout title={site.name} description={site.seo.defaultDescription}>

  <!-- ===== HERO ===== -->
  <section class="relative pt-20 pb-24 md:pt-28 md:pb-32 lg:pt-32 lg:pb-36 overflow-hidden">
    <!-- Background layers -->
    <div class="absolute inset-0 bg-gradient-to-br from-[oklch(0.965_0.01_230)] via-white to-[oklch(0.96_0.015_175)]"></div>
    <div class="absolute top-10 right-0 w-[500px] h-[500px] bg-[oklch(0.92_0.04_175/0.3)] rounded-full blur-[100px]"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-[oklch(0.94_0.02_230/0.25)] rounded-full blur-[100px]"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[oklch(0.97_0.01_200/0.2)] rounded-full blur-[120px]"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <!-- Copy -->
        <div class="max-w-xl">
          <Badge variant="secondary" class="mb-6 bg-[oklch(0.92_0.03_175)] text-[oklch(0.30_0.06_175)] shadow-sm">
            <span class="mr-1.5 inline-block w-2 h-2 rounded-full bg-accent animate-pulse"></span>
            Australian Telehealth Services
          </Badge>

          <h1 class="font-heading text-4xl font-extrabold tracking-tight text-primary leading-[1.08] sm:text-5xl lg:text-[3.5rem] mb-6">
            Your health journey,<br />
            <span class="text-accent">guided every step</span>
          </h1>

          <p class="text-lg text-muted-foreground leading-relaxed mb-8 md:text-xl md:leading-relaxed">
            Trusted medical guidance for weight management, peptide therapy, and medical cannabis. We go beyond the prescription with genuine follow-up care that supports your long-term wellbeing.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-10">
            <a href="/contact" data-slot="button" data-variant="default" data-size="lg" class="group/btn inline-flex h-12 items-center justify-center gap-2.5 rounded-full bg-primary px-8 text-sm font-semibold text-primary-foreground shadow-sm relative overflow-hidden">
              Start Your Consultation
              <svg class="w-4 h-4 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
            </a>
            <a href="/how-it-works" data-slot="button" data-variant="outline" data-size="lg" class="group/btn inline-flex h-12 items-center justify-center gap-2.5 rounded-full border border-border/60 bg-background px-8 text-sm font-semibold relative overflow-hidden">
              See How It Works
              <svg class="w-4 h-4 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
            </a>
          </div>

          <!-- Stats row -->
          <div class="flex items-center gap-8 pt-8 border-t border-border/60">
            <div>
              <p class="font-heading text-2xl font-extrabold text-primary">100%</p>
              <p class="text-xs text-muted-foreground mt-0.5">Patient follow-up</p>
            </div>
            <div class="w-px h-10 bg-border"></div>
            <div>
              <p class="font-heading text-2xl font-extrabold text-primary">3</p>
              <p class="text-xs text-muted-foreground mt-0.5">Specialised services</p>
            </div>
            <div class="w-px h-10 bg-border"></div>
            <div>
              <p class="font-heading text-2xl font-extrabold text-primary">AU</p>
              <p class="text-xs text-muted-foreground mt-0.5">Nationwide coverage</p>
            </div>
          </div>
        </div>

        <!-- Hero visual -->
        <div class="relative hidden lg:block">
          <!-- Main image -->
          <div class="aspect-[4/3] rounded-3xl overflow-hidden shadow-2xl shadow-primary/10 ring-1 ring-black/5">
            <Image
              src={heroImage}
              alt="Healthcare professional using laptop and stethoscope for a telehealth consultation"
              class="w-full h-full object-cover"
              width={600}
              height={450}
              loading="eager"
            />
          </div>

          <!-- Floating card: Trust -->
          <div class="absolute -bottom-4 -left-4 bg-white rounded-2xl p-5 shadow-xl ring-1 ring-black/5">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-accent/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
              </div>
              <div>
                <p class="font-heading font-bold text-primary text-sm">TGA & AHPRA Compliant</p>
                <p class="text-xs text-muted-foreground">Australian regulatory standards</p>
              </div>
            </div>
          </div>

          <!-- Floating card: Ongoing care -->
          <div class="absolute -top-4 -right-4 bg-white rounded-2xl p-5 shadow-xl ring-1 ring-black/5">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-accent flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
              </div>
              <div>
                <p class="font-heading font-bold text-primary text-sm">Ongoing Care</p>
                <p class="text-xs text-muted-foreground">Not just a prescription</p>
              </div>
            </div>
          </div>

          <!-- Floating card: support -->
          <div class="absolute top-1/2 -right-6 -translate-y-1/2 bg-white rounded-2xl px-5 py-4 shadow-xl ring-1 ring-black/5">
            <div class="flex items-center gap-3">
              <div class="flex -space-x-2">
                <div class="w-8 h-8 rounded-full bg-accent/20 ring-2 ring-white flex items-center justify-center"><span class="text-[10px] font-bold text-accent">SM</span></div>
                <div class="w-8 h-8 rounded-full bg-primary/20 ring-2 ring-white flex items-center justify-center"><span class="text-[10px] font-bold text-primary">JT</span></div>
                <div class="w-8 h-8 rounded-full bg-accent/20 ring-2 ring-white flex items-center justify-center"><span class="text-[10px] font-bold text-accent">LK</span></div>
              </div>
              <p class="text-xs text-muted-foreground font-medium">Trusted by patients<br/>across Australia</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SERVICE PATHWAYS ===== -->
  <Section id="services" padding="lg">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <p class="text-sm font-semibold text-accent uppercase tracking-wider mb-3">Our Services</p>
      <h2 class="font-heading text-3xl font-bold tracking-tight text-primary sm:text-4xl mb-4">
        Choose your health goal
      </h2>
      <p class="text-lg text-muted-foreground">
        Specialised telehealth consultations across three key areas — each with the genuine follow-up care that sets us apart.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      <!-- Weight Management -->
      <div class="group relative rounded-2xl border border-border bg-white overflow-hidden hover:shadow-2xl hover:shadow-accent/8 transition-all duration-500 hover:-translate-y-1">
        <div class="absolute inset-x-0 top-0 h-1 rounded-t-2xl bg-gradient-to-r from-accent/0 via-accent to-accent/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10"></div>
        <div class="aspect-[16/9] overflow-hidden relative">
          <Image
            src={serviceWeightImg}
            alt="Woman exercising as part of a guided weight management program"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            width={480}
            height={270}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-white via-white/20 to-transparent"></div>
        </div>
        <div class="p-8 pt-4">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-accent/10 to-accent/5 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 -mt-10 relative z-10 ring-4 ring-white">
          <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
        </div>
        <h3 class="font-heading text-xl font-bold text-primary mb-3">Weight Management</h3>
        <p class="text-muted-foreground mb-6 leading-relaxed text-[15px]">
          Clinically guided weight loss programs tailored to women 35 and over. Sustainable, medically supervised approaches with ongoing support.
        </p>
        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-3 text-sm text-muted-foreground">
            <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            Personalised treatment plans
          </li>
          <li class="flex items-start gap-3 text-sm text-muted-foreground">
            <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            Regular check-ins and adjustments
          </li>
          <li class="flex items-start gap-3 text-sm text-muted-foreground">
            <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            Ongoing nutritional guidance
          </li>
        </ul>
        <a href="/services/weight-management" class="inline-flex items-center text-sm font-semibold text-accent hover:text-accent/80 transition-colors gap-2 group/link">
          Learn more
          <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        </div>
      </div>

      <!-- Peptide Therapy -->
      <div class="group relative rounded-2xl border border-border bg-white overflow-hidden hover:shadow-2xl hover:shadow-accent/8 transition-all duration-500 hover:-translate-y-1">
        <div class="absolute inset-x-0 top-0 h-1 rounded-t-2xl bg-gradient-to-r from-accent/0 via-accent to-accent/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10"></div>
        <div class="aspect-[16/9] overflow-hidden relative">
          <Image
            src={servicePeptideImg}
            alt="Medical laboratory research supporting evidence-based peptide therapy"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            width={480}
            height={270}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-white via-white/20 to-transparent"></div>
        </div>
        <div class="p-8 pt-4">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-accent/10 to-accent/5 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 -mt-10 relative z-10 ring-4 ring-white">
          <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" /></svg>
        </div>
        <h3 class="font-heading text-xl font-bold text-primary mb-3">Peptide Therapy</h3>
        <p class="text-muted-foreground mb-6 leading-relaxed text-[15px]">
          Medically prescribed peptide therapies for performance, recovery, and general wellness. Evidence-based protocols with proper monitoring.
        </p>
        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-3 text-sm text-muted-foreground">
            <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            Evidence-based protocols
          </li>
          <li class="flex items-start gap-3 text-sm text-muted-foreground">
            <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            Muscle building and recovery
          </li>
          <li class="flex items-start gap-3 text-sm text-muted-foreground">
            <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            Anti-ageing and wellness
          </li>
        </ul>
        <a href="/services/peptide-therapy" class="inline-flex items-center text-sm font-semibold text-accent hover:text-accent/80 transition-colors gap-2 group/link">
          Learn more
          <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        </div>
      </div>

      <!-- Medical Cannabis -->
      <div class="group relative rounded-2xl border border-border bg-white overflow-hidden hover:shadow-2xl hover:shadow-accent/8 transition-all duration-500 hover:-translate-y-1">
        <div class="absolute inset-x-0 top-0 h-1 rounded-t-2xl bg-gradient-to-r from-accent/0 via-accent to-accent/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10"></div>
        <div class="aspect-[16/9] overflow-hidden relative">
          <Image
            src={serviceCannabisImg}
            alt="Healthcare professional discussing treatment plan with patient"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            width={480}
            height={270}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-white via-white/20 to-transparent"></div>
        </div>
        <div class="p-8 pt-4">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-accent/10 to-accent/5 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 -mt-10 relative z-10 ring-4 ring-white">
          <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
        </div>
        <h3 class="font-heading text-xl font-bold text-primary mb-3">Medical Cannabis</h3>
        <p class="text-muted-foreground mb-6 leading-relaxed text-[15px]">
          Prescribed access to medical cannabis for chronic pain and mental wellbeing. Compassionate, compliant care with thorough assessment.
        </p>
        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-3 text-sm text-muted-foreground">
            <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            Chronic pain management
          </li>
          <li class="flex items-start gap-3 text-sm text-muted-foreground">
            <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            Mental and emotional wellbeing
          </li>
          <li class="flex items-start gap-3 text-sm text-muted-foreground">
            <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            TGA-approved pathways
          </li>
        </ul>
        <a href="/services/medical-cannabis" class="inline-flex items-center text-sm font-semibold text-accent hover:text-accent/80 transition-colors gap-2 group/link">
          Learn more
          <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        </div>
      </div>
    </div>
  </Section>

  <!-- ===== HOW IT WORKS ===== -->
  <section id="how-it-works" class="py-16 md:py-24 bg-gradient-to-b from-[oklch(0.975_0.005_230/0.5)] to-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <p class="text-sm font-semibold text-accent uppercase tracking-wider mb-3">How It Works</p>
        <h2 class="font-heading text-3xl font-bold tracking-tight text-primary sm:text-4xl mb-4">
          Your path to better health in four steps
        </h2>
        <p class="text-lg text-muted-foreground">
          From your first enquiry through to ongoing care, we make the process straightforward and supportive.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-0">
        <!-- Step 1 -->
        <div class="relative text-center lg:px-6">
          <div class="w-16 h-16 rounded-2xl bg-white border-2 border-accent/20 flex items-center justify-center mx-auto mb-5 shadow-sm relative z-10">
            <span class="font-heading text-2xl font-bold text-accent">1</span>
          </div>
          <h3 class="font-heading text-lg font-bold text-primary mb-2">Submit Your Enquiry</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Complete a brief online form with your health goals and medical history.
          </p>
          <div class="hidden lg:block absolute top-8 left-[calc(50%+2.5rem)] w-[calc(100%-5rem)] h-px bg-gradient-to-r from-accent/30 via-accent/15 to-accent/30"></div>
        </div>

        <!-- Step 2 -->
        <div class="relative text-center lg:px-6">
          <div class="w-16 h-16 rounded-2xl bg-white border-2 border-accent/20 flex items-center justify-center mx-auto mb-5 shadow-sm relative z-10">
            <span class="font-heading text-2xl font-bold text-accent">2</span>
          </div>
          <h3 class="font-heading text-lg font-bold text-primary mb-2">Doctor Consultation</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Speak with an Australian-registered prescriber via secure telehealth.
          </p>
          <div class="hidden lg:block absolute top-8 left-[calc(50%+2.5rem)] w-[calc(100%-5rem)] h-px bg-gradient-to-r from-accent/30 via-accent/15 to-accent/30"></div>
        </div>

        <!-- Step 3 -->
        <div class="relative text-center lg:px-6">
