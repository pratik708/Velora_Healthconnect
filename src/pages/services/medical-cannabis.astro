---
import PageLayout from "@layouts/PageLayout.astro";
import Section from "@components/sections/Section.astro";
import Badge from "@components/astro-ui/Badge.astro";
import { Image } from "astro:assets";
import { site } from "@/data/site";

import consultationImg from "@assets/images/site/medical-consultation.jpg";
import patientCareImg from "@assets/images/site/patient-care.jpg";
---

<PageLayout
  title="Medical Cannabis"
  description="TGA-compliant medical cannabis access for chronic pain and wellbeing. Velora HealthConnect provides compassionate telehealth consultations with ongoing follow-up care across Australia."
>
  <!-- ===== HERO ===== -->
  <section class="relative pt-16 pb-12 md:pt-24 md:pb-16 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[oklch(0.965_0.01_230)] via-white to-[oklch(0.96_0.015_175)]"></div>
    <div class="absolute top-10 right-0 w-[400px] h-[400px] bg-[oklch(0.92_0.04_175/0.2)] rounded-full blur-[100px]"></div>
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <Badge variant="secondary" class="mb-6 bg-[oklch(0.92_0.03_175)] text-[oklch(0.30_0.06_175)]">
        <svg class="w-3.5 h-3.5 mr-1.5 inline-block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
        Medical Cannabis
      </Badge>
      <h1 class="font-heading text-4xl font-extrabold tracking-tight text-primary sm:text-5xl md:text-6xl mb-6">
        Compassionate access,<br class="hidden sm:block" />
        <span class="text-accent">TGA-compliant care</span>
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-muted-foreground md:text-xl leading-relaxed">
        Prescribed access to medical cannabis for chronic pain and mental wellbeing. Thorough assessment, proper monitoring, and genuine follow-up care through Australia's trusted telehealth pathway.
      </p>
    </div>
  </section>

  <!-- ===== OVERVIEW ===== -->
  <Section id="overview" padding="lg">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <p class="text-sm font-semibold text-accent uppercase tracking-wider mb-3">About Medical Cannabis</p>
        <h2 class="font-heading text-3xl font-bold tracking-tight text-primary sm:text-4xl mb-6">
          Legal, regulated access for eligible patients
        </h2>
        <div class="space-y-4 text-muted-foreground leading-relaxed">
          <p>
            Medical cannabis has been legal in Australia since 2016 when prescribed through the TGA's Special Access Scheme or by an Authorised Prescriber. It offers an alternative treatment pathway for patients living with chronic pain, anxiety, insomnia, and other conditions where conventional treatments have been insufficient.
          </p>
          <p>
            At Velora HealthConnect, we take a compassionate, thorough approach to medical cannabis. Every patient undergoes a comprehensive clinical assessment before any treatment is considered. We do not rush the process — your prescriber will take the time to understand your full medical history, current treatments, and health goals.
          </p>
          <p>
            Importantly, we go beyond the prescription. Every patient receives scheduled follow-up appointments, ongoing monitoring, and access to our dedicated support team. We believe that proper medical cannabis care requires genuine, relationship-based healthcare.
          </p>
        </div>
      </div>
      <div class="relative">
        <div class="aspect-[4/3] rounded-3xl overflow-hidden shadow-xl">
          <Image
            src={consultationImg}
            alt="Healthcare professional discussing treatment plan with patient"
            class="w-full h-full object-cover"
            width={600}
            height={450}
          />
        </div>
        <!-- Floating card -->
        <div class="absolute -bottom-4 -left-4 bg-white rounded-2xl p-5 shadow-xl ring-1 ring-black/5">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-accent/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
            </div>
            <div>
              <p class="font-heading font-bold text-primary text-sm">TGA Compliant</p>
              <p class="text-xs text-muted-foreground">Fully regulated pathway</p>
            </div>
          </div>
        </div>
        <!-- Floating card top right -->
        <div class="absolute -top-4 -right-4 bg-white rounded-2xl p-5 shadow-xl ring-1 ring-black/5">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-accent flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
            </div>
            <div>
              <p class="font-heading font-bold text-primary text-sm">Compassionate Care</p>
              <p class="text-xs text-muted-foreground">Patient-centred approach</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- ===== CONDITIONS ===== -->
  <section class="py-16 md:py-24 bg-gradient-to-b from-[oklch(0.975_0.005_230/0.5)] to-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <p class="text-sm font-semibold text-accent uppercase tracking-wider mb-3">Conditions We Treat</p>
        <h2 class="font-heading text-3xl font-bold tracking-tight text-primary sm:text-4xl mb-4">
          Who may benefit from medical cannabis?
        </h2>
        <p class="text-lg text-muted-foreground">
          Medical cannabis may be considered for patients where conventional treatments have not provided adequate relief. Common conditions include:
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border p-6 hover:shadow-lg hover:shadow-accent/5 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-accent/10 flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 01-6.364 0M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm-.375 0h.008v.015h-.008V9.75zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75zm-.375 0h.008v.015h-.008V9.75z" /></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-primary mb-2">Chronic Pain</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Persistent pain conditions including neuropathic pain, musculoskeletal pain, and other chronic pain syndromes that have not responded adequately to conventional treatment.
          </p>
        </div>

        <div class="rounded-2xl border border-border p-6 hover:shadow-lg hover:shadow-accent/5 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-accent/10 flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" /></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-primary mb-2">Anxiety</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Generalised anxiety disorder and related conditions where other treatments have been tried without sufficient improvement.
          </p>
        </div>

        <div class="rounded-2xl border border-border p-6 hover:shadow-lg hover:shadow-accent/5 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-accent/10 flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" /></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-primary mb-2">Insomnia</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Chronic sleep difficulties that significantly impact quality of life and have not responded to standard interventions.
          </p>
        </div>

        <div class="rounded-2xl border border-border p-6 hover:shadow-lg hover:shadow-accent/5 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-accent/10 flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.182 16.318A4.486 4.486 0 0012.016 15a4.486 4.486 0 00-3.198 1.318M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm-.375 0h.008v.015h-.008V9.75zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75zm-.375 0h.008v.015h-.008V9.75z" /></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-primary mb-2">PTSD</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Post-traumatic stress disorder symptoms including flashbacks, nightmares, and hypervigilance where conventional treatments alone have not been adequate.
          </p>
        </div>

        <div class="rounded-2xl border border-border p-6 hover:shadow-lg hover:shadow-accent/5 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-accent/10 flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5" /></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-primary mb-2">Nausea</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Chemotherapy-induced nausea and other severe nausea conditions where standard anti-emetics have not provided adequate relief.
          </p>
        </div>

        <div class="rounded-2xl border border-border p-6 hover:shadow-lg hover:shadow-accent/5 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-accent/10 flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" /></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-primary mb-2">Other Conditions</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Various other conditions may be eligible. If you are unsure whether medical cannabis could be appropriate for your situation, submit an enquiry and our team can advise.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== THE LEGAL FRAMEWORK ===== -->
  <Section id="legal" padding="lg">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-sm font-semibold text-accent uppercase tracking-wider mb-3">The Legal Framework</p>
        <h2 class="font-heading text-3xl font-bold tracking-tight text-primary sm:text-4xl mb-4">
          How medical cannabis works in Australia
        </h2>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
          Understanding the legal pathway gives patients confidence that their treatment is fully legitimate and regulated.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="rounded-2xl border border-border p-8">
          <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
          </div>
          <h3 class="font-heading text-xl font-bold text-primary mb-3">TGA Special Access Scheme</h3>
          <p class="text-muted-foreground leading-relaxed text-sm">
            The TGA's Special Access Scheme (SAS-B) allows medical practitioners to prescribe medical cannabis for patients who have not responded to conventional treatments. Each application is assessed individually. Velora HealthConnect's prescribers handle the full TGA application process on your behalf.
          </p>
        </div>

        <div class="rounded-2xl border border-border p-8">
          <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
          </div>
          <h3 class="font-heading text-xl font-bold text-primary mb-3">Authorised Prescriber Pathway</h3>
          <p class="text-muted-foreground leading-relaxed text-sm">
            Authorised Prescribers have been granted TGA approval to prescribe specific medical cannabis products for defined conditions. This pathway can streamline access for eligible patients. Your prescriber will determine the most appropriate pathway based on your circumstances.
          </p>
        </div>

        <div class="rounded-2xl border border-border p-8">
          <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>
          </div>
          <h3 class="font-heading text-xl font-bold text-primary mb-3">Fully Legal & Regulated</h3>
          <p class="text-muted-foreground leading-relaxed text-sm">
            A valid prescription from a registered medical practitioner makes medical cannabis use completely legal. Products are sourced from licensed suppliers and dispensed by authorised pharmacies. You receive a legitimate medical product with full regulatory oversight.
          </p>
        </div>

        <div class="rounded-2xl border border-border p-8">
          <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
          </div>
          <h3 class="font-heading text-xl font-bold text-primary mb-3">We Handle the Paperwork</h3>
          <p class="text-muted-foreground leading-relaxed text-sm">
            The TGA approval process can seem complex. Our clinical team manages all the regulatory applications and paperwork on your behalf, so you can focus on your health rather than bureaucracy.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="py-16 md:py-24 bg-gradient-to-b from-[oklch(0.975_0.005_230/0.5)] to-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <p class="text-sm font-semibold text-accent uppercase tracking-wider mb-3">The Process</p>
        <h2 class="font-heading text-3xl font-bold tracking-tight text-primary sm:text-4xl mb-4">
          How it works
        </h2>
        <p class="text-lg text-muted-foreground">
          From your first enquiry through to ongoing care — a clear, supportive process.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-0">
        <div class="relative text-center lg:px-6">
          <div class="w-16 h-16 rounded-2xl bg-white border-2 border-accent/20 flex items-center justify-center mx-auto mb-5 shadow-sm relative z-10">
            <span class="font-heading text-2xl font-bold text-accent">1</span>
          </div>
          <h3 class="font-heading text-lg font-bold text-primary mb-2">Submit Your Enquiry</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Complete a brief form with your health background, current conditions, and treatments you have tried.
          </p>
          <div class="hidden lg:block absolute top-8 left-[calc(50%+2.5rem)] w-[calc(100%-5rem)] h-px bg-gradient-to-r from-accent/30 via-accent/15 to-accent/30"></div>
        </div>

        <div class="relative text-center lg:px-6">
          <div class="w-16 h-16 rounded-2xl bg-white border-2 border-accent/20 flex items-center justify-center mx-auto mb-5 shadow-sm relative z-10">
            <span class="font-heading text-2xl font-bold text-accent">2</span>
          </div>
          <h3 class="font-heading text-lg font-bold text-primary mb-2">Clinical Assessment</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            A comprehensive consultation with your prescriber to review your history and assess eligibility for medical cannabis.
          </p>
          <div class="hidden lg:block absolute top-8 left-[calc(50%+2.5rem)] w-[calc(100%-5rem)] h-px bg-gradient-to-r from-accent/30 via-accent/15 to-accent/30"></div>
        </div>

        <div class="relative text-center lg:px-6">
          <div class="w-16 h-16 rounded-2xl bg-white border-2 border-accent/20 flex items-center justify-center mx-auto mb-5 shadow-sm relative z-10">
            <span class="font-heading text-2xl font-bold text-accent">3</span>
          </div>
          <h3 class="font-heading text-lg font-bold text-primary mb-2">TGA Approval & Dispensing</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            If approved, we handle the TGA application. Your medication is dispensed by a licensed pharmacy and delivered to you.
          </p>
          <div class="hidden lg:block absolute top-8 left-[calc(50%+2.5rem)] w-[calc(100%-5rem)] h-px bg-gradient-to-r from-accent/30 via-accent/15 to-accent/30"></div>
        </div>

        <div class="relative text-center lg:px-6">
          <div class="w-16 h-16 rounded-2xl bg-accent flex items-center justify-center mx-auto mb-5 shadow-lg shadow-accent/20 relative z-10">
            <span class="font-heading text-2xl font-bold text-white">4</span>
          </div>
          <h3 class="font-heading text-lg font-bold text-primary mb-2">Ongoing Follow-Up</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Regular check-ins with your prescriber, dosage adjustments, and dedicated support every step of the way.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <Section id="faq" padding="lg">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-sm font-semibold text-accent uppercase tracking-wider mb-3">FAQs</p>
        <h2 class="font-heading text-3xl font-bold tracking-tight text-primary sm:text-4xl mb-4">
          Medical cannabis questions
        </h2>
      </div>

      <div class="space-y-4">
        <details class="group rounded-2xl border border-border overflow-hidden hover:border-accent/20 transition-colors">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <h3 class="font-heading font-semibold text-primary pr-4">Is medical cannabis legal in Australia?</h3>
            <svg class="w-5 h-5 text-muted-foreground flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-6 pb-6 text-muted-foreground leading-relaxed">
            Yes. Medical cannabis has been legal in Australia since 2016 when prescribed by a registered medical practitioner through TGA-approved pathways (Special Access Scheme or Authorised Prescriber). A valid prescription is required. Velora HealthConnect operates in full compliance with all TGA and AHPRA regulations.
          </div>
        </details>

        <details class="group rounded-2xl border border-border overflow-hidden hover:border-accent/20 transition-colors">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <h3 class="font-heading font-semibold text-primary pr-4">Will I get high from medical cannabis?</h3>
            <svg class="w-5 h-5 text-muted-foreground flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-6 pb-6 text-muted-foreground leading-relaxed">
            Medical cannabis products vary widely. Many formulations are CBD-dominant and do not produce intoxicating effects. Products that contain THC may have some psychoactive effects, which your prescriber will discuss with you in detail. The goal is therapeutic benefit, and dosing is carefully managed to minimise unwanted effects.
          </div>
        </details>

        <details class="group rounded-2xl border border-border overflow-hidden hover:border-accent/20 transition-colors">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <h3 class="font-heading font-semibold text-primary pr-4">Can I drive while using medical cannabis?</h3>
            <svg class="w-5 h-5 text-muted-foreground flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-6 pb-6 text-muted-foreground leading-relaxed">
            Driving laws around medical cannabis vary by state and territory. In most Australian jurisdictions, it is illegal to drive with THC in your system, even with a valid prescription. Your prescriber will discuss the driving implications specific to your state and the products prescribed. CBD-only products may have different considerations.
          </div>
        </details>

        <details class="group rounded-2xl border border-border overflow-hidden hover:border-accent/20 transition-colors">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <h3 class="font-heading font-semibold text-primary pr-4">How long does the TGA approval process take?</h3>
            <svg class="w-5 h-5 text-muted-foreground flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-6 pb-6 text-muted-foreground leading-relaxed">
            SAS-B applications are typically processed within a few business days. The Authorised Prescriber pathway may be faster depending on your prescriber's existing approvals. We keep you informed throughout the process and aim to minimise any delays.
          </div>
        </details>

        <details class="group rounded-2xl border border-border overflow-hidden hover:border-accent/20 transition-colors">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <h3 class="font-heading font-semibold text-primary pr-4">How much does medical cannabis treatment cost?</h3>
            <svg class="w-5 h-5 text-muted-foreground flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-6 pb-6 text-muted-foreground leading-relaxed">
            Costs include the consultation fee and the cost of prescribed cannabis products. Medical cannabis is not currently covered by the PBS, so patients pay out of pocket. We are transparent about all costs upfront. Contact our team for current pricing details.
          </div>
        </details>

        <details class="group rounded-2xl border border-border overflow-hidden hover:border-accent/20 transition-colors">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <h3 class="font-heading font-semibold text-primary pr-4">Do I need to have tried other treatments first?</h3>
            <svg class="w-5 h-5 text-muted-foreground flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-6 pb-6 text-muted-foreground leading-relaxed">
            Generally, yes. Medical cannabis is typically considered when conventional treatments have been tried without adequate results. Your prescriber will review your treatment history during the consultation. If you are unsure whether you meet the criteria, submit an enquiry and our team can advise.
          </div>
        </details>
      </div>
    </div>
  </Section>

