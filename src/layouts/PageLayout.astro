---
import BaseLayout from "./BaseLayout.astro";
import Header from "@components/common/Header.astro";
import Footer from "@components/common/Footer.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  ogType?: string;
  robots?: string;
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
</BaseLayout>
